# Vercel CLI deploys upload the working tree and read this file, not `.gitignore`.
# Without it the upload walks `node_modules`, the Next.js cache and the Rust
# target directory — 1.3 GB and well past the plan's 5000-request upload limit.
# The Git integration is unaffected: it builds from a GitHub clone.

# --- Dependencies and build output, all regenerated by the Vercel build ---
node_modules
.next
out
dist
coverage
.turbo
.tests
test-results
playwright-report
*.tsbuildinfo
*.log

# --- Desktop shell: Rust artefacts have no part in the web build ---
target
apps/hq/src-tauri/gen
apps/hq/src-tauri/.cargo
*.pdb

# --- Local-only state ---
.git
.vercel
.claude/worktrees
.idea
.husky/_

# --- Machine-local material mirror and runtime overrides ---
shared/materials
apps/hq/public/config/project.override.json
apps/hq/public/config/bridge.local.json
apps/hq/public/runtime/project.override.json
apps/hq/src-tauri/media-gateway.config.local.json
apps/file-bridge/bridge.config.json
*.local.json
!*.example.json

# --- Secrets: values come from the project's environment variables ---
.env
.env.*
!.env.example
!**/.env.example
