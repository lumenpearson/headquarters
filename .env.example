# Environment for `docker compose` at the repository root. It configures the
# container deployment of `apps/control-plane` and nothing else: the Next.js
# application, the file bridge and the Tauri shell are not containerized
# (docs/adr/0010-container-deployment.md says why).
#
# Generate the real file rather than editing a copy by hand:
#
#     node scripts/generate-env.mjs
#
# Every `<generate>` below is replaced with an independent 64-character random
# value. The script prints the variable names and the path it wrote, never a
# value, and refuses to overwrite an existing `.env` without `--force`.
#
# `.env` is git-ignored. Nothing in it belongs in a commit, an issue or a log.

# --- Secrets ------------------------------------------------------------------

# The password for the PostgreSQL container's `headquarters` role. Compose
# builds the control plane's connection URL from it, so changing it after the
# first `up` requires removing the volume as well: PostgreSQL only reads this
# when it initializes an empty data directory.
POSTGRES_PASSWORD=<generate>

# The HMAC pepper every stored credential hash is derived under. Rotating it
# invalidates every access token, refresh token, pairing code and mutation
# receipt in the database at once, because the stored hashes no longer match
# anything a client can present. It never leaves the server process.
HQ_CONTROL_PLANE_AUTH_TOKEN_PEPPER=<generate>

# The secret `CreateGroup` requires, presented as `x-hq-bootstrap-secret`. It is
# what stops anyone who can reach the port from creating a group on this
# deployment. Hold it the way you would hold a root password.
HQ_CONTROL_PLANE_BOOTSTRAP_SECRET=<generate>

# --- Deployment ---------------------------------------------------------------

# Where the control plane answers on this machine. Compose publishes to
# `127.0.0.1` only, never to every interface: the packaged desktop shell's
# content security policy admits loopback and `*.vercel.app`, and cannot be made
# to admit a LAN address, so a plane published on `192.168.x.x` is unreachable
# from the shell that has to pair with it (docs/release/known-limitations.md).
HQ_CONTROL_PLANE_PUBLISHED_PORT=4100

# The image compose runs. The default is the local tag `docker compose build`
# writes, so a clone builds and runs its own. To run a published image instead,
# set this to `ghcr.io/<owner>/<repository>/control-plane`, set HQ_IMAGE_TAG to
# a release tag, and `docker compose pull` before `up`.
HQ_CONTROL_PLANE_IMAGE=gremuchaya-control-plane
HQ_IMAGE_TAG=local

# The origins a browser client may present. This replaces the whole list rather
# than adding to it, so the packaged desktop's two `tauri.localhost` origins have
# to stay in it. Add the address the operator's browser uses, if it is not one of
# these four.
HQ_CONTROL_PLANE_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://tauri.localhost,https://tauri.localhost
