{
  "name": "@gremuchaya/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src",
    "test": "vitest run",
    "dev": "tsx --env-file-if-exists=.env watch src/server.ts",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@gremuchaya/protocol": "workspace:*",
    "@neondatabase/serverless": "1.1.0",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@connectrpc/connect-web": "2.1.2",
    "@types/node": "26.2.0",
    "@types/ws": "8.18.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
