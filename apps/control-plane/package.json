{
  "name": "@gremuchaya/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./fetch": {
      "types": "./dist/fetch-adapter.d.ts",
      "import": "./dist/fetch-adapter.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "lint": "eslint src",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@gremuchaya/domain": "workspace:*",
    "@gremuchaya/protocol": "workspace:*",
    "@gremuchaya/settings-schema": "workspace:*",
    "@neondatabase/serverless": "1.1.0",
    "@noble/hashes": "2.3.0",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.2",
    "pg": "8.23.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@connectrpc/connect-web": "2.1.2",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
