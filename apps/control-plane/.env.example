HQ_CONTROL_PLANE_PORT=4100
# The interface the RPC and realtime server binds to. Loopback by default, so
# nothing starts answering more widely because it was upgraded. The shoot-day
# topology is one machine serving the others over the set's LAN, and that needs
# an address other machines can route to -- `0.0.0.0`, or the LAN address
# itself. An IPv4 address, an IPv6 address or a hostname; no scheme, no port.
HQ_CONTROL_PLANE_HOST=127.0.0.1
# Defaults to the two development addresses plus http://tauri.localhost and
# https://tauri.localhost, which is the Origin a packaged WebView2 desktop
# build sends. Setting this variable replaces the whole list, so a packaged
# desktop must still be named in it.
HQ_CONTROL_PLANE_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://tauri.localhost,https://tauri.localhost
# Optional for local health-only development. Required by `pnpm --filter @gremuchaya/control-plane migrate`.
HQ_CONTROL_PLANE_DATABASE_URL=postgresql://<role>:<password>@<neon-host>/<database>?sslmode=require
# Optional. How the control plane reaches the URL above: `neon` (the default) is
# the HTTP driver, one HTTPS request per statement, no pool -- and a route to the
# public internet on every one of them. `postgres` is node-postgres over TCP,
# with a connection pool and real transactions, which is what lets the database
# be a machine on the set's own LAN with no internet at all. Unset behaves
# exactly as this package always has. The URL does not decide it: Neon's compute
# speaks the wire protocol too, so one connection string is valid for both, and
# the choice belongs to the deployment. Against Neon keep `neon`: a free compute
# suspends after five minutes of inactivity and takes every pooled connection
# with it. For a LAN PostgreSQL, write `sslmode` deliberately -- `pg` treats
# `sslmode=require` as `verify-full` and refuses a self-signed certificate, so a
# closed network with no certificate wants `sslmode=disable`. See
# `docs/release/environment.md`.
HQ_CONTROL_PLANE_DATABASE_DRIVER=neon
# Whether startup applies the schema migrations itself. `true` by default, and
# an unset value means `true`, so a long-lived process keeps migrating exactly
# as it always has. Set it `false` only where the deployment runs
# `pnpm --filter @gremuchaya/control-plane migrate` as a build step -- a
# serverless web deployment, where every cold start would otherwise open the
# same `pg_advisory_xact_lock` transaction. `false` without that build step
# leaves the process serving against whatever schema the database has;
# `Health`'s `database` detail says which of the two is in force.
HQ_CONTROL_PLANE_RUN_MIGRATIONS_ON_START=true
# Both Redis values are optional and must be set together. With them, presence
# reports OFFLINE for a device whose liveness key has expired, and group
# publications are rate limited. Without them the control plane still serves:
# presence reports the last state a device recorded, and publications are
# unlimited. `Health` says which of the two is in force.
# Whitespace around either value is trimmed.
HQ_CONTROL_PLANE_REDIS_REST_URL=https://<redis-id>.upstash.io
HQ_CONTROL_PLANE_REDIS_REST_TOKEN=<upstash-rest-token>
# The same pair under the names the Vercel Upstash Marketplace integration
# writes into a project's Production and Preview environments. They are read
# only when neither HQ_CONTROL_PLANE_REDIS_REST_* name is set, so the two above
# always win; the fallback exists because the platform cannot alias one variable
# onto another and copying a live token by hand into a second variable is what
# this project avoids. A pair split across the two schemes is refused at startup
# and names the missing half rather than borrowing it from the other scheme:
# the two schemes can address two different Redis instances, and a URL paired
# with a token minted elsewhere would coordinate against a database nobody
# chose. Set these two locally only to reproduce a deployment; otherwise leave
# them unset -- which is why they ship commented out: a copy of this file with
# the HQ_* pair removed must still start in the no-Redis branch.
# KV_REST_API_URL=https://<redis-id>.upstash.io
# KV_REST_API_TOKEN=<upstash-rest-token>
# The same integration also injects KV_URL, REDIS_URL and
# KV_REST_API_READ_ONLY_TOKEN. None is read here: the first two are `rediss://`
# connection strings for a TCP client rather than the HTTPS REST endpoint, and
# the read-only token can write neither a liveness key nor a rate-limit counter.
# Their presence alone leaves the control plane in its no-Redis branch.
# Optional durable paired-device auth. Auth stays disabled only when every
# HQ_CONTROL_PLANE_AUTH_* value and HQ_CONTROL_PLANE_BOOTSTRAP_SECRET is unset.
# When enabled, a PostgreSQL URL plus both independent 32+ non-whitespace-character secrets are
# required. Keep real values in the deployment secret store; do not commit them.
# `<generate>` is a marker, not a value: it is what
# `node scripts/generate-env.mjs --template apps/control-plane/.env.example`
# replaces with an independent 64-character random secret. Only these two lines
# carry it, because these are the only two values in this file that must be
# unguessable rather than merely correct. Inventing them by hand is what the
# script exists to make unnecessary.
HQ_CONTROL_PLANE_AUTH_TOKEN_PEPPER=<generate>
HQ_CONTROL_PLANE_BOOTSTRAP_SECRET=<generate>
# The current persisted HMAC domain version is deliberately exact.
HQ_CONTROL_PLANE_AUTH_TOKEN_HASH_VERSION=v1
# Bounded defaults: access 15m, refresh 30d, pairing code 10m.
HQ_CONTROL_PLANE_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
HQ_CONTROL_PLANE_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
HQ_CONTROL_PLANE_AUTH_PAIRING_CODE_TTL_SECONDS=600
# Opt-in real-PostgreSQL suite (src/postgres.integration.test.ts). Unset, that
# suite skips and `pnpm test` stays offline. DESTRUCTIVE: it creates and drops
# its own `hqtest_*` databases beside the one this URL names, and sweeps any
# abandoned `hqtest_*` older than an hour before it starts. Point it at a
# database that exists only for this -- `hq_scratch` beside the deployment
# database, not the deployment database itself. The suite refuses to run when
# this URL resolves to the same host and database as the URL above.
HQ_CONTROL_PLANE_TEST_DATABASE_URL=postgresql://<role>:<password>@<neon-host>/hq_scratch?sslmode=require
# Optional, `neon` or `postgres`, default `neon`. Which driver those suites run
# through. There is one variable and no second copy of the suites: setting it to
# `postgres` re-runs all eight of them against the TCP adapter, which is what
# "the two drivers satisfy one contract" has to mean.
HQ_CONTROL_PLANE_TEST_DATABASE_DRIVER=neon
# Optional S3-compatible object storage for material uploads, downloads and
# previews. All five values below are required together; a partial group refuses
# to start and names the missing variable. Without the group the control plane
# still serves, and BeginUpload, CreateMaterialVersion, GetDownloadGrant and
# GetPreviewGrant answer FAILED_PRECONDITION naming this configuration;
# `Health` reports `storage` either way. Signing is AWS Signature Version 4 with
# no SDK, so any S3-compatible endpoint works: AWS S3, Cloudflare R2, MinIO.
# The endpoint is the service origin alone -- no bucket, no path. It must be
# HTTPS; plain http is accepted only for 127.0.0.1, localhost or [::1], for a
# MinIO on this machine. The secret stays inside a signing closure and is
# never placed on the configuration object, in a response or in an error.
HQ_CONTROL_PLANE_STORAGE_ENDPOINT=https://s3.<region>.amazonaws.com
HQ_CONTROL_PLANE_STORAGE_REGION=<region>
HQ_CONTROL_PLANE_STORAGE_BUCKET=<bucket-name>
HQ_CONTROL_PLANE_STORAGE_ACCESS_KEY_ID=<access-key-id>
HQ_CONTROL_PLANE_STORAGE_SECRET_ACCESS_KEY=<secret-access-key>
# Optional. `true` addresses objects as https://endpoint/bucket/key (MinIO and
# most self-hosted stores); the default `false` uses https://bucket.endpoint/key.
HQ_CONTROL_PLANE_STORAGE_FORCE_PATH_STYLE=false
# Optional, 60 to 900. A grant is a bearer capability on the bucket and must not
# outlive the access token that obtained it, so 15 minutes is both the default
# and the ceiling.
HQ_CONTROL_PLANE_STORAGE_GRANT_TTL_SECONDS=900
# Optional quality-ladder conversion. `true` makes this process render the
# variants the material library queues -- 1080p/720p/480p for a video, a
# thumbnail for a still -- and `GetPreviewGrant` then signs the rendition's own
# key. Default `false`, and false is what every deployment before this pipeline
# behaved as: the ladder is queued in `conversion_jobs`, nothing consumes it,
# and every preview variant is the original object served inline. It needs the
# HQ_CONTROL_PLANE_STORAGE_* group as well -- with no bucket there are no bytes
# to convert -- and ffmpeg on PATH. `Health` reports `conversion` and
# `GetCapabilities` reports `materials.rendition-pipeline` either way.
HQ_CONTROL_PLANE_CONVERSION_WORKER=false
# Optional. The two executables the worker runs, spawned without a shell, with
# no request data in any argument. Unset means whatever is on PATH. Windows
# wants the full path, e.g. C:\ffmpeg\bin\ffmpeg.exe.
HQ_CONTROL_PLANE_FFMPEG_PATH=ffmpeg
HQ_CONTROL_PLANE_FFPROBE_PATH=ffprobe
# Optional, 30 to 14400. How long a claimed job is owned before another worker
# may take it over. A worker that dies mid-render returns its job to the queue
# after this long, and no sooner.
HQ_CONTROL_PLANE_CONVERSION_LEASE_SECONDS=300
# Optional, 5 to 14400, and it must not exceed the lease above: a render allowed
# to outlive its own lease would be taken over while still running, and two
# ffmpeg processes would produce one object.
HQ_CONTROL_PLANE_CONVERSION_TIMEOUT_SECONDS=240
# Optional, 1 to 600. How often the worker asks for a job.
HQ_CONTROL_PLANE_CONVERSION_POLL_SECONDS=5
# Optional, 1 to 10. After this many attempts a job stays FAILED and keeps the
# tail of whatever the renderer said as its reason.
HQ_CONTROL_PLANE_CONVERSION_MAX_ATTEMPTS=3
# Optional, 1 to 524288 (megabytes). A take larger than this is not converted;
# its preview keeps serving the original, which is what the menu reports.
HQ_CONTROL_PLANE_CONVERSION_MAX_SOURCE_MEGABYTES=8192
# Optional GitHub egress for CreateIssue, CreateTranslationPullRequest and
# GetPullRequestStatus. The two values below are required together; a partial
# group refuses to start and names the missing variable. Without the group the
# control plane still serves -- BuildIssueDraft and OpenPrefilledIssue, which a
# shoot with no credential uses, work either way -- and the three RPCs above
# answer FAILED_PRECONDITION naming this configuration; `Health` reports
# `github` and `GetCapabilities` reports `integration.github-egress` either way.
# The token stays inside a configuration closure and is never placed on the
# gateway, in a response, in an error or in a job result. It is spent only by a
# group that registered no GitHub installation of its own, and only against the
# repository named here, which no request can change. Keep the real value in the
# deployment secret store; do not commit it.
HQ_CONTROL_PLANE_GITHUB_TOKEN=<github-token>
# owner/name, and the only repository this deployment's own token may reach.
HQ_CONTROL_PLANE_GITHUB_REPOSITORY=<owner>/<name>
# Optional, default https://api.github.com. A GitHub Enterprise Server base is
# https://<host>/api/v3. HTTPS, because the token travels in a request header;
# plain http is accepted only for 127.0.0.1, localhost or [::1].
HQ_CONTROL_PLANE_GITHUB_API_BASE_URL=https://api.github.com
# Optional, comma-separated. Labels every issue this control plane opens carries.
HQ_CONTROL_PLANE_GITHUB_ISSUE_LABELS=hq,report
# Optional. Where a translation proposal is committed on the branch its pull
# request opens from; both {locale} and {key} are required. The default commits
# a proposal record rather than editing a message catalogue: this control plane
# cannot parse an arbitrary repository's catalogue format, and a pull request
# rewriting one it had guessed at would be worse than a reviewable record.
HQ_CONTROL_PLANE_GITHUB_TRANSLATION_PATH=translations/proposals/{locale}/{key}.json
# Optional Vercel Blob object storage, the second grant issuer. It replaces the
# HQ_CONTROL_PLANE_STORAGE_* group rather than joining it: a library's bytes live
# in one store, and a deployment that set both is refused at startup. The two
# values below are required together.
#
# This issuer plans ONE part per upload. Blob signs a part on the client, so the
# control plane cannot address a second one, and the store is told so before it
# reserves anything -- five parts sent to one address would silently store the
# last slice under the whole file's hash. Multipart uploads are therefore not
# available with this issuer, and an object above the single-request ceiling is
# refused before a material row exists.
#
# A download or preview grant here is a public store URL with no signature to
# check: its expiry says when the client should ask again, not when the address
# stops working. The read-write token stays inside a configuration closure; what
# a client receives is a short-lived upload token minted per grant and never
# persisted. That derivation has not been presented to the live service -- keep
# the real token in the deployment secret store; do not commit it.
HQ_CONTROL_PLANE_BLOB_STORAGE_TOKEN=vercel_blob_rw_<store>_<secret>
# The store origin objects are served from, without a path. This is the same
# origin the client reads as NEXT_PUBLIC_HQ_MATERIAL_STORAGE_ORIGIN.
HQ_CONTROL_PLANE_BLOB_STORAGE_PUBLIC_BASE_URL=https://<store>.public.blob.vercel-storage.com
# Optional, default https://blob.vercel-storage.com. HTTPS only: every call
# carries a token in a request header rather than a signature in a URL.
HQ_CONTROL_PLANE_BLOB_STORAGE_API_BASE_URL=https://blob.vercel-storage.com
# Optional, default 900 seconds, same bounds as the S3 grant lifetime.
HQ_CONTROL_PLANE_BLOB_STORAGE_GRANT_TTL_SECONDS=900
# Optional, default 104857600 (100 MiB), between 1 MiB and 1 GiB. The platform
# publishes no single-request ceiling, so the deployment states the one it will
# accept; an upload above it is refused at BeginUpload.
HQ_CONTROL_PLANE_BLOB_STORAGE_MAX_OBJECT_BYTES=104857600
