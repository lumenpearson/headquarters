# JavaScript API v3 key created in the Yandex Developer Dashboard.
# Restrict the key to the HTTP Referer origins that serve this application.
# Copy this file to .env.local and keep the real key out of source control.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Camera channels use bundled demo videos, assigned local materials and an
# explicitly approved local webcam by default. The RTSP gateway is a dormant
# compatibility adapter and must be opted into deliberately.
NEXT_PUBLIC_HQ_ENABLE_NATIVE_RTSP_GATEWAY=false

# Optional external compatibility-gateway origin for a browser deployment.
# Never put RTSP credentials in a NEXT_PUBLIC variable.
NEXT_PUBLIC_HQ_RTSP_GATEWAY_ORIGIN=
