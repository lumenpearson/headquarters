{
  "name": "@gremuchaya/hq",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "build:desktop": "cross-env HQ_TARGET=desktop next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src tests next.config.ts playwright.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:ui": "playwright test",
    "analyze": "next experimental-analyze --output",
    "build:memory": "next build --experimental-debug-memory-usage",
    "tauri": "tauri"
  },
  "dependencies": {
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-web": "2.1.2",
    "@gremuchaya/config": "workspace:*",
    "@gremuchaya/domain": "workspace:*",
    "@gremuchaya/protocol": "workspace:*",
    "@gremuchaya/settings-schema": "workspace:*",
    "@gremuchaya/ui": "workspace:*",
    "@noble/hashes": "2.3.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@vidstack/react": "1.15.6",
    "next": "16.3.1",
    "postcss": "^8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "shadcn": "^4.18.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
