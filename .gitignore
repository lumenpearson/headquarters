# --- Dependencies and build output ---
node_modules/
.next/
out/
dist/
coverage/
playwright-report/
test-results/
.tests/
.turbo/
*.tsbuildinfo
target/
apps/hq/src-tauri/gen/
apps/hq/src-tauri/.cargo/
*.pdb
*.log

# --- Operating system ---
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets and per-machine configuration ---
# Never commit a real environment file. Only *.example files are tracked, so a
# stray `.env` cannot leak deployment credentials.
.env
.env.*
!.env.example
!**/.env.example

# Local runtime overrides: these carry real shoot-machine mount paths and keys.
apps/hq/public/config/project.override.json
apps/hq/public/config/bridge.local.json
apps/hq/public/runtime/project.override.json
apps/hq/src-tauri/media-gateway.config.local.json
apps/file-bridge/bridge.config.json
*.local.json
!*.example.json

# Production material mirror stays local to the machine.
shared/materials/*
!shared/materials/.gitkeep

# --- Tooling and editors ---
.vercel/
.idea/
*.swp
*.swo

# --- Agent and assistant local state ---
.aider*

# --- Scratch files ---
.tmp-*
*.tmp
*.bak
*.orig
*.rej

# --- Git ---
.husky/_/
.git
.github/changeset-version.js
.github/collect-prerelease-info.js
.github/version-script-next.js

# --- Agent worktrees ---
# `isolation: worktree` in .claude/agents/*.md checks a worktree out here, inside
# the repository. Untracked it would still be scanned by `pnpm format:check` and
# `pnpm lint`, which is how a subagent run turned the local gate red.
.claude/worktrees/

# --- buf module cache ---
# `buf generate` writes its module cache beside the module. It is a cache, not
# a contract: the generated bindings under `packages/protocol/src/gen` are the
# committed artefact.
packages/protocol/v3/
